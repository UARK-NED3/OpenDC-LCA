{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UARK-NED3/OpenDC-LCA/schemas/scenario.schema.json",
  "title": "OpenDC-LCA Phase 1 scenario",
  "type": "object",
  "required": [
    "name", "cooling_architecture", "it_capacity_kw", "capacity_factor",
    "pue", "facility_lifetime_years", "onsite_water_l_per_kwh_it",
    "grid", "components", "study", "data_sources"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "cooling_architecture": { "type": "string", "minLength": 1 },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional_unit", "system_boundary", "electricity_accounting",
        "water_metric", "allocation_method", "intended_use",
        "comparative_assertion", "ghg_method", "primary_energy_method",
        "water_method", "replacement_model", "critical_review_status"
      ],
      "properties": {
        "functional_unit": { "enum": ["it_mwh"] },
        "system_boundary": {
          "enum": [
            "cooling_system_cradle_to_grave",
            "facility_cradle_to_grave",
            "custom"
          ]
        },
        "electricity_accounting": {
          "enum": ["location_based", "market_based", "consequential"]
        },
        "water_metric": { "type": "string", "minLength": 1 },
        "allocation_method": { "type": "string", "minLength": 1 },
        "intended_use": { "type": "string", "minLength": 1 },
        "comparative_assertion": { "type": "boolean" },
        "ghg_method": { "type": "string", "minLength": 1 },
        "primary_energy_method": { "type": "string", "minLength": 1 },
        "water_method": { "type": "string", "minLength": 1 },
        "replacement_model": {
          "enum": ["discrete", "linearized", "reliability"]
        },
        "critical_review_status": {
          "enum": [
            "not_required", "planned", "internal", "independent",
            "independent_panel"
          ]
        },
        "boundary_definition": {
          "type": "object",
          "required": ["included_processes", "excluded_processes", "rationale"],
          "additionalProperties": false,
          "properties": {
            "included_processes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "excluded_processes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "it_capacity_kw": { "type": "number", "exclusiveMinimum": 0 },
    "capacity_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "pue": { "type": "number", "minimum": 1 },
    "facility_lifetime_years": { "type": "number", "exclusiveMinimum": 0 },
    "onsite_water_l_per_kwh_it": { "type": "number", "minimum": 0 },
    "grid": {
      "type": "object",
      "required": [
        "ghg_kgco2e_per_kwh", "primary_energy_mj_per_kwh",
        "blue_water_l_per_kwh"
      ],
      "additionalProperties": false,
      "properties": {
        "ghg_kgco2e_per_kwh": { "type": "number", "minimum": 0 },
        "primary_energy_mj_per_kwh": { "type": "number", "minimum": 0 },
        "blue_water_l_per_kwh": { "type": "number", "minimum": 0 }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "quantity", "service_life_years", "production"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "service_life_years": {
            "type": "number", "exclusiveMinimum": 0
          },
          "production": { "$ref": "#/$defs/impacts" },
          "end_of_life": { "$ref": "#/$defs/impactsWithCredits" },
          "reliability": { "$ref": "#/$defs/reliability" }
        },
        "additionalProperties": false
      }
    },
    "input_source_map": {
      "type": "object",
      "description": "Field-level mapping from scenario input paths to declared data-source IDs.",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "source_type", "citation", "license",
          "geography", "reference_year", "quality", "uncertainty",
          "review_status", "confidentiality"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "citation": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "geography": { "type": "string", "minLength": 1 },
          "reference_year": { "type": "integer" },
          "quality": { "type": "string", "minLength": 1 },
          "uncertainty": {
            "type": "object",
            "required": ["distribution", "parameters", "notes"],
            "additionalProperties": false,
            "properties": {
              "distribution": { "type": "string", "minLength": 1 },
              "parameters": { "type": "object" },
              "notes": { "type": "string" }
            }
          },
          "review_status": {
            "enum": [
              "unreviewed", "internally_reviewed", "independently_reviewed"
            ]
          },
          "confidentiality": {
            "enum": ["public", "aggregated_confidential", "confidential"]
          }
        }
      }
    },
    "fluid": { "type": ["object", "null"] },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "impacts": {
      "type": "object",
      "required": ["ghg_kgco2e", "primary_energy_mj", "blue_water_l"],
      "properties": {
        "ghg_kgco2e": { "type": "number", "minimum": 0 },
        "primary_energy_mj": { "type": "number", "minimum": 0 },
        "blue_water_l": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "impactsWithCredits": {
      "type": "object",
      "required": ["ghg_kgco2e", "primary_energy_mj", "blue_water_l"],
      "properties": {
        "ghg_kgco2e": { "type": "number" },
        "primary_energy_mj": { "type": "number" },
        "blue_water_l": { "type": "number" }
      },
      "additionalProperties": false
    },
    "reliability": {
      "type": "object",
      "required": [
        "model", "characteristic_life_years", "shape",
        "repair_downtime_hours", "affected_capacity_fraction",
        "maintenance_downtime_hours"
      ],
      "properties": {
        "model": { "enum": ["weibull", "arrhenius_weibull"] },
        "characteristic_life_years": {
          "type": "number", "exclusiveMinimum": 0
        },
        "shape": { "type": "number", "exclusiveMinimum": 0 },
        "reference_temperature_c": { "type": "number", "exclusiveMinimum": -273.15 },
        "operating_temperature_c": { "type": "number", "exclusiveMinimum": -273.15 },
        "activation_energy_ev": { "type": "number", "exclusiveMinimum": 0 },
        "repair_downtime_hours": { "type": "number", "minimum": 0 },
        "affected_capacity_fraction": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "maintenance_interval_years": {
          "type": ["number", "null"], "exclusiveMinimum": 0
        },
        "maintenance_downtime_hours": { "type": "number", "minimum": 0 },
        "maintenance_impacts": { "$ref": "#/$defs/impacts" }
      },
      "allOf": [{
        "if": {
          "properties": { "model": { "const": "arrhenius_weibull" } }
        },
        "then": {
          "required": [
            "reference_temperature_c",
            "operating_temperature_c",
            "activation_energy_ev"
          ]
        }
      }],
      "additionalProperties": false
    }
  }
}
