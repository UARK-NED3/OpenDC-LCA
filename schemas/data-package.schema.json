{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UARK-NED3/OpenDC-LCA/schemas/data-package.schema.json",
  "title": "OpenDC-LCA dataset package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id", "title", "version", "creators", "contact",
    "source_url_or_doi", "data_layer", "method", "geography",
    "reference_period", "functional_unit", "system_boundary",
    "uncertainty", "data_quality", "license",
    "redistribution_permitted", "files"
  ],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contact": { "type": "string", "minLength": 1 },
    "source_url_or_doi": { "type": "string" },
    "data_layer": {
      "enum": ["foreground", "background", "scenario"]
    },
    "method": { "type": "string", "minLength": 1 },
    "geography": { "type": "string", "minLength": 1 },
    "reference_period": { "type": "string", "minLength": 1 },
    "functional_unit": { "type": "string", "minLength": 1 },
    "system_boundary": { "type": "string", "minLength": 1 },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "parameters", "method", "notes"],
      "properties": {
        "distribution": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "method": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability", "completeness", "temporal",
        "geographical", "technological", "review_status"
      ],
      "properties": {
        "reliability": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "completeness": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "temporal": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "geographical": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "technological": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "review_status": {
          "enum": ["unreviewed", "internally_reviewed", "independently_reviewed"]
        }
      }
    },
    "license": { "type": "string", "minLength": 1 },
    "redistribution_permitted": { "type": "boolean" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
