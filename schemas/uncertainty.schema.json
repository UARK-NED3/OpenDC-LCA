{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UARK-NED3/OpenDC-LCA/schemas/uncertainty.schema.json",
  "title": "OpenDC-LCA independent Monte Carlo specification",
  "type": "object",
  "required": ["samples", "seed", "parameters"],
  "additionalProperties": false,
  "properties": {
    "samples": {"type": "integer", "minimum": 2},
    "seed": {"type": "integer"},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["parameter", "distribution", "parameters"],
        "additionalProperties": false,
        "properties": {
          "parameter": {
            "enum": [
              "it_capacity_kw", "capacity_factor", "pue",
              "facility_lifetime_years", "onsite_water_l_per_kwh_it",
              "grid.ghg_kgco2e_per_kwh",
              "grid.primary_energy_mj_per_kwh",
              "grid.blue_water_l_per_kwh",
              "fluid.annual_loss_fraction"
            ]
          },
          "distribution": {
            "enum": ["uniform", "triangular", "normal", "lognormal"]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          },
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    }
  }
}
